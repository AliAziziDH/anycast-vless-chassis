#!/usr/bin/env python3
"""
Lightweight VPN Telemetry API Daemon.
Listens on localhost:8080.
Exposes /api/telemetry with real-time stats (CPU, Mem, Bandwidth, Connections, BBR).
"""

import os
import json
import subprocess
import re
import urllib.request
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from decimal import Decimal

ACCESS_LOG = "/var/log/nginx/vpn_access.log"

def get_cpu_usage():
    """Reads /proc/stat to get CPU usage percentage over a short interval."""
    def read_cpu():
        try:
            with open('/proc/stat', 'r') as f:
                lines = f.readlines()
                for line in lines:
                    if line.startswith('cpu '):
                        parts = [int(p) for p in line.split()[1:]]
                        idle = parts[3] + parts[4]
                        total = sum(parts)
                        return idle, total
        except Exception:
            return 0, 0
        return 0, 0

    idle1, total1 = read_cpu()
    time.sleep(0.1)
    idle2, total2 = read_cpu()

    total_diff = total2 - total1
    idle_diff = idle2 - idle1
    if total_diff == 0:
        return 0.0

    return round(100.0 * (1.0 - idle_diff / total_diff), 2)

def get_mem_usage():
    """Reads /proc/meminfo to get memory usage percentage."""
    mem_total = 0
    mem_available = 0
    try:
        with open('/proc/meminfo', 'r') as f:
            for line in f:
                if line.startswith('MemTotal:'):
                    mem_total = int(line.split()[1])
                elif line.startswith('MemAvailable:'):
                    mem_available = int(line.split()[1])
        if mem_total > 0:
            return round(100.0 * (1.0 - (mem_available / mem_total)), 2)
    except Exception:
        pass
    return 0.0

def get_total_bandwidth():
    """Calculates cumulative bandwidth from nginx logs."""
    if not os.path.exists(ACCESS_LOG):
        return 0.0

    total_bytes = 0
    try:
        with open(ACCESS_LOG, 'r') as f:
            for line in f:
                try:
                    data = json.loads(line)
                    if 'body_bytes_sent' in data:
                        total_bytes += int(data['body_bytes_sent'])
                except (ValueError, json.JSONDecodeError):
                    match = re.search(r'\s(\d+)\s"(?:-|[^"]+)"\s"(?:-|[^"]+)"$', line)
                    if match:
                        total_bytes += int(match.group(1))
                    else:
                        parts = line.split()
                        for p in reversed(parts):
                            if p.isdigit():
                                total_bytes += int(p)
                                break
    except Exception:
        pass

    return float(Decimal(total_bytes) / Decimal(1024**3))

def get_active_connections():
    """Gets active connection counts."""
    # Try Nginx stub_status if reachable
    try:
        req = urllib.request.Request("http://127.0.0.1:8081/nginx_status") # assuming stub status is moved to 8081 or so
        with urllib.request.urlopen(req, timeout=1) as response:
            content = response.read().decode('utf-8')
            match = re.search(r'Active connections:\s+(\d+)', content)
            if match:
                return int(match.group(1))
    except Exception:
        pass

    # Fallback to ss
    try:
        result = subprocess.run(['ss', '-s'], capture_output=True, text=True, check=True)
        match = re.search(r'TCP:\s+\d+\s+\(estab (\d+)', result.stdout)
        if match:
            return int(match.group(1))
    except Exception:
        pass

    return 0

def get_bbr_stats():
    """Parses active BBR pacing speed and mrtt."""
    stats = []
    try:
        result = subprocess.run(['ss', '-ti', 'state', 'established'], capture_output=True, text=True, check=True)
        lines = result.stdout.split('\n')
        for line in lines:
            if ' bbr ' in line or ' cubic ' in line:
                bw_match = re.search(r'bw:(\d+(?:\.\d+)?)([A-Za-z]+)', line)
                mrtt_match = re.search(r'mrtt:(\d+(?:\.\d+)?)', line)
                if bw_match:
                    val = float(bw_match.group(1))
                    unit = bw_match.group(2).lower()
                    if unit == 'mbps':
                        bw_mbps = val
                    elif unit == 'kbps':
                        bw_mbps = val / 1024
                    elif unit == 'gbps':
                        bw_mbps = val * 1024
                    elif unit == 'bps':
                        bw_mbps = val / (1024 * 1024)
                    else:
                        bw_mbps = val # default assume mbps if weird unit
                else:
                    bw_mbps = 0.0

                mrtt = float(mrtt_match.group(1)) if mrtt_match else 0.0
                stats.append({"bw_mbps": bw_mbps, "mrtt_ms": mrtt})
    except Exception:
        pass
    return stats

class TelemetryHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/api/telemetry':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()

            bbr_list = get_bbr_stats()
            avg_bw = sum(s['bw_mbps'] for s in bbr_list) / len(bbr_list) if bbr_list else 0.0
            avg_mrtt = sum(s['mrtt_ms'] for s in bbr_list) / len(bbr_list) if bbr_list else 0.0

            data = {
                "cpu_percent": get_cpu_usage(),
                "mem_percent": get_mem_usage(),
                "bandwidth_gb": round(get_total_bandwidth(), 4),
                "connections": get_active_connections(),
                "bbr_avg_bw_mbps": round(avg_bw, 2),
                "bbr_avg_mrtt_ms": round(avg_mrtt, 2),
                "bbr_connections": len(bbr_list)
            }
            self.wfile.write(json.dumps(data).encode())
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass # Suppress logging

def run(server_class=HTTPServer, handler_class=TelemetryHandler, port=8080):
    server_address = ('127.0.0.1', port)
    httpd = server_class(server_address, handler_class)
    print(f"Telemetry API Daemon running on 127.0.0.1:{port}...")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    httpd.server_close()

if __name__ == "__main__":
    run()
